# RDS MySQL in the PRIVATE subnets: no public IP, encrypted, daily backups.
# The master password is generated by AWS and stored in Secrets Manager,
# so it never appears in our code or in the Terraform state file.

resource "aws_db_subnet_group" "main" {
  name       = "${var.project}-db-subnets"
  subnet_ids = aws_subnet.private[*].id # must span 2 AZs, even for a single DB
  tags       = { Name = "${var.project}-db-subnets" }
}

resource "aws_db_instance" "main" {
  identifier     = "${var.project}-db"
  engine         = "mysql"
  engine_version = "8.0"
  instance_class = var.db_instance_class

  allocated_storage = 20
  storage_type      = "gp3"
  storage_encrypted = true

  db_name                     = "minibank"
  username                    = "mbadmin"
  manage_master_user_password = true # password lives in Secrets Manager

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.db.id]
  publicly_accessible    = false
  multi_az               = false # Phase 2 turns this on

  backup_retention_period = 7

  # Lab settings so `terraform destroy` works cleanly. In production: the opposite.
  skip_final_snapshot = true
  deletion_protection = false
  apply_immediately   = true

  tags = { Name = "${var.project}-db" }
}
